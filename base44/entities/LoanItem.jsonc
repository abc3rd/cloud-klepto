{
  "name": "LoanItem",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string",
      "description": "Name of the item being loaned"
    },
    "item_description": {
      "type": "string",
      "description": "Description of the item"
    },
    "item_photo": {
      "type": "string",
      "description": "Photo URL of the item"
    },
    "lender_email": {
      "type": "string",
      "description": "Email of the lender"
    },
    "lender_name": {
      "type": "string",
      "description": "Name of the lender"
    },
    "borrower_email": {
      "type": "string",
      "description": "Email of the borrower"
    },
    "borrower_name": {
      "type": "string",
      "description": "Name of the borrower"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "return_pending",
        "returned",
        "requested_back",
        "lost",
        "stolen",
        "overdue"
      ],
      "default": "active"
    },
    "loan_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "return_date": {
      "type": "string",
      "format": "date"
    },
    "return_photo": {
      "type": "string",
      "description": "Photo URL confirming return"
    },
    "notes": {
      "type": "string"
    },
    "condition_at_loan": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "good",
        "fair",
        "poor"
      ]
    },
    "condition_at_return": {
      "type": "string",
      "enum": [
        "new",
        "like_new",
        "good",
        "fair",
        "poor"
      ]
    },
    "tracker_type": {
      "type": "string",
      "enum": [
        "tile",
        "airtag",
        "samsung_tag",
        "chipolo",
        "manual"
      ],
      "description": "Type of tracking device attached"
    },
    "tracker_url": {
      "type": "string",
      "description": "Sharing URL for the tracker app"
    },
    "tracker_location": {
      "type": "string",
      "description": "Manual last known location"
    }
  },
  "required": [
    "item_name",
    "lender_email",
    "lender_name",
    "borrower_email",
    "borrower_name",
    "loan_date",
    "due_date"
  ]
}